{{- $isWSL := (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{- $isLaptop := eq .chezmoi.hostname "arch-laptop" -}}
{{- $packages := .packages.shared.pacman -}}
{{- $aurPackages := .packages.shared.aur -}}
{{- if and (not $isWSL) (not $isLaptop) -}}
{{- $packages = concat $packages .packages.desktop_only.pacman -}}
{{- $aurPackages = concat $aurPackages .packages.desktop_only.aur -}}
{{- end -}}
{{- if and (not $isWSL) $isLaptop -}}
{{- $packages = concat $packages .packages.laptop_only.pacman -}}
{{- end -}}
{{- if eq .chezmoi.osRelease.id "arch" -}}
#!/bin/bash
set -e

sudo pacman -S --needed --noconfirm {{ $packages | join " " }}
{{ if not $isWSL }}
yay -S --needed --noconfirm {{ $aurPackages | join " " }}

xdg-user-dirs-update
mkdir -p ~/Pictures/Screenshots
{{ end -}}
{{ end -}}
