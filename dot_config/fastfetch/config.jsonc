{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/asuka.png",
        "width": 48,
        "padding": {
            "top": 1,
            "right": 1,
            "left": 1,
        },
    },
    "display": {
        "separator": " ┃ ",
        "color": {
            "keys": "red",
            "title": "bright_red",
        },
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;31m「ふーん、準備はいい？ あんたの実力、アタシにしっかり見せなさいよね！」\u001b[0m",
        },
        "break",
        {
            "type": "title",
            "format": " \u001b[1;41;30m ARCH \u001b[0m \u001b[1;31m samemaru\u001b[0m",
        },
        {
            "type": "custom",
            "format": "\u001b[90m ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m",
        },
        {
            "type": "os",
            "key": " 󰣇 SYSTEM ",
            "keyColor": "red",
        },
        {
            "type": "shell",
            "key": " 󰞷 SHELL  ",
            "keyColor": "light_red",
        },
        {
            "type": "terminal",
            "key": "  TERM   ",
            "keyColor": "light_red",
        },
        {
            "type": "wm",
            "key": " 󱂬 ENV    ",
            "keyColor": "light_red",
        },
        "break",
        {
            "type": "cpu",
            "key": " 󰻠 COMPUTE",
            "keyColor": "yellow",
            "temp": true,
        },
        {
            "type": "gpu",
            "key": " 󰍹 RENDER ",
            "keyColor": "yellow",
        },
        {
            "type": "memory",
            "key": " 󰑭 RAM    ",
            "keyColor": "yellow",
        },
        {
            "type": "disk",
            "key": " 󰋊 NVME   ",
            "keyColor": "yellow",
            "folders": "/",
        },
        "break",
        {
            "type": "command",
            "key": " 󰅐 STAMP  ",
            "keyColor": "white",
            "text": "date '+%Y.%m.%d - %H:%M:%S'",
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle",
        },
        "break",
    ],
}
