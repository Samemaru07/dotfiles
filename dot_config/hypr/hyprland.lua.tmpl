{{- $laptop := eq .chezmoi.hostname "arch-laptop" -}}
-- Hyprland 0.57+ (Lua)
-- ホスト名がarch-laptopならラップトップ、それ以外はデスクトップ向けに分岐する

------------------
---- MONITORS ----
------------------

{{- if $laptop }}
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "auto"
})
{{- else }}
hl.monitor({ output = "DP-1", mode = "1920x1080@60", position = "0x0", scale = 1 })
hl.monitor({ output = "DP-2", mode = "1920x1080@60", position = "1920x0", scale = 1 })

-- 奇数ワークスペースはDP-1, 偶数はDP-2。1と2が各モニタのデフォルト
for i = 1, 10 do
    local mon = (i % 2 == 1) and "DP-1" or "DP-2"
    hl.workspace_rule({ workspace = tostring(i), monitor = mon, default = (i <= 2) })
end
{{- end }}

---------------------
---- My PROGRAMS ----
---------------------

local terminal = "ghostty"
local fileManager = "dolphin"
local menu = "wofi --show drun"

--------------------
---- AUTO START ----
--------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("fcitx5 -d")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("nm-applet --indicator")
    hl.exec_cmd("/usr/lib/polkit-kde-authentication-agent-1")
    hl.exec_cmd("waybar")
    hl.exec_cmd("quickshell -c qs-hyprview")
    hl.exec_cmd("quickshell -c qs-cal")
    hl.exec_cmd("quickshell -c qs-notif")
{{- if not $laptop }}
    hl.exec_cmd("hyprctl setcursor FernCursor 24")
    hl.exec_cmd("openrgb --startminimized")
    hl.exec_cmd("spotify")
    hl.exec_cmd("zen-browser")
    hl.exec_cmd('kitty --class="cava" -e cava')
    hl.exec_cmd('kitty --class="asciiquarium" -e asciiquarium')
    hl.exec_cmd('kitty --class="tty-clock" -e tty-clock -c')
    hl.exec_cmd('kitty --class="btop" -e btop')
{{- end}}
end)

