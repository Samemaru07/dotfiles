---------------------
---- KEYBINDINGS ----
---------------------

local mainMod = "SUPER"

hl.bind(mainMod .. " + Q", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + C", hl.dsp.window.close())
hl.bind(mainMod .. " + M", hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"))
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + R", hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + P", hl.dsp.window.pseudo())
hl.bind(mainMod .. " + J", hl.dsp.layout("togglesplit"))

hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }))

-- mainMod + [0-9] でワークスペース切り替え、mainMod + SHIFT + [0-9] でウィンドウ移動
for i = 1, 10 do
    local key = i % 10
    hl.bind(mainMod .. " + " .. key,         hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }))
end

hl.bind(mainMod .. " + S",         hl.dsp.workspace.toggle_special("magic"))
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }))

hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- 音量・メディアキー
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
hl.bind("XF86AudioMute",        hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true, repeating = true })
hl.bind("XF86AudioMicMute",     hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),   { locked = true, repeating = true })

hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })

-- quickshell
hl.bind(mainMod .. " + TAB", hl.dsp.exec_cmd("quickshell ipc -c qs-hyprview call expose toggle columnar"))

-- 直前にアクティブだったウィンドウへ戻る
hl.bind("ALT + TAB", hl.dsp.focus({ last = true }))

{{- if $laptop }}

-- 輝度キー
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"), { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"), { locked = true, repeating = true })

-- カバーを閉じたらロックしてサスペンド (ちらつき防止)
hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd("pidof hyprlock || hyprlock & sleep 3; systemctl suspend"), { locked = true })

{{- end }}
-- スクショ (ファイル名を入力して ~/Pictures/ に保存)
hl.bind("Print", hl.dsp.exec_cmd([[
    filename=$(zenity --entry --title="スクショ保存" --text="ファイル名を入力してください（拡張子不要）:")
    if [ -n "$filename" ]; then
        grim -g "$(slurp)" "$HOME/Pictures/${filename}.png"
    fi
]]))
hl.bind("SUPER + Print", hl.dsp.exec_cmd([[
    filename=$(zenity --entry --title="全画面スクショ保存" --text="ファイル名を入力してください（拡張子不要）:")
    if [ -n "$filename" ]; then
        grim "$HOME/Pictures/${filename}.png"
    fi
]]))

--------------------------------
---- WINDOWS AND WORKSPACES ----
--------------------------------

hl.window_rule({
    name  = "suppress-maximize-events",
    match = { class = ".*" },

    suppress_event = "maximize",
})

hl.window_rule({
    name  = "fix-xwayland-drags",
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },

    no_focus = true,
})

hl.window_rule({
    name  = "move-hyprland-run",
    match = { class = "hyprland-run" },

    move  = { 20, "monitor_h-120" },
    float = true,
})

-- 以降のルールで個別に上書きする
hl.window_rule({
    name  = "float-center-all",
    match = { class = ".*" },

    float  = true,
    center = true,
})

{{- if $laptop }}

hl.window_rule({
    name  = "zen-rule",
    match = { class = "^zen$" },

    float = false,
})

hl.window_rule({
    name  = "ghostty-rule",
    match = { class = "^com[.]mitchellh[.]ghostty$" },

    float  = false,
})
{{- else }}

-- WS1 (Dashboard)
hl.window_rule({
    name  = "ws1-spotify",
    match = { class = "^Spotify$" },

    workspace = "1 silent",
    float     = true,
    size      = { 1000, 600 },
    move      = { 50, 50 },
})

hl.window_rule({
    name  = "ws1-cava",
    match = { class = "^cava$" },

    workspace = "1 silent",
    float     = true,
    size      = { 1000, 350 },
    move      = { 50, 680 },
})

hl.window_rule({
    name  = "ws1-asciiquarium",
    match = { class = "^asciiquarium$" },

    workspace = "1 silent",
    float     = true,
    size      = { 770, 700 },
    move      = { 1100, 50 },
})

hl.window_rule({
    name  = "ws1-tty-clock",
    match = { class = "^tty-clock$" },

    workspace = "1 silent",
    float     = true,
    size      = { 770, 250 },
    move      = { 1100, 780 },
})

-- WS2 (Terminal)
hl.window_rule({
    name  = "ws2-ghostty",
    match = { class = "^com[.]mitchellh[.]ghostty$" },

    workspace = "2 silent",
    float     = false,
})

hl.window_rule({
    name  = "ws2-feh",
    match = { class = "^feh$" },

    workspace = "2 silent",
    float     = true,
    center    = true,
})

-- WS3 (Browser)
hl.window_rule({
    name  = "ws3-zen-browser",
    match = { class = "^zen$" },

    workspace = "3 silent",
    float     = false,
})

-- WS4 (System Monitor)
hl.window_rule({
    name  = "ws4-btop",
    match = { class = "^btop$" },

    workspace = "4 silent",
    float     = true,
    size      = { 1800, 1000 },
    center    = true,
})
{{- end }}
