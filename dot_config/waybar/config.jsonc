{
    "margin-top": 3,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": ["custom/power", "hyprland/workspaces", "hyprland/window"],
    "modules-right": [
        "group/sys",
        "custom/skk",
        "group/conn",
        "group/out",
        "custom/sep",
        "custom/cc",
    ],
    "custom/skk": {
        "exec": "test \"$(fcitx5-remote)\" = \"2\" && echo \"あ\" || echo \"Ａ\"",
        "interval": 1,
        "format": "{}",
        "tooltip": false,
        "on-click": "fcitx5-remote -t",
    },
    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "wlogout -b 5",
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "cursor": true,
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "on-click": "blueman-manager",
        "align": 0.5,
    },
    "network": {
        "format-wifi": " ",
        "format-ethernet": "  Ethernet",
        "format-linked": "  Linked (No IP)",
        "format-disconnected": "  Disconnected",
        "tooltip": false,
        "on-click": "nm-connection-editor",
        "align": 0.5,
    },
    "battery": {
        "states": {
            "good": 85,
            "warning": 30,
            "critical": 15,
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{time}",
        "cursor": false,
    },
    "custom/battery": {
        "format": "  100%",
        "tooltip": false,
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "default": [" "],
        },
        "on-click": "~/.config/waybar/scripts/toggle-pavucontrol.sh",
        "scroll-step": 5,
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    },
    "clock": {
        "format": "{:%a %Y/%m/%d %H:%M}",
        "tooltip-format": "<span size=\"15000\"><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<b>{}</b>",
                "weekdays": "<b>{}</b>",
                "days": "{}",
                "today": "<b><u>{}</u></b>",
            },
        },
        "on-click": "swaync-client -t -sw",
    },
    "modules-center": ["clock"],
    "group/sys": {
        "orientation": "inherit",
        "modules": ["cpu", "memory"],
    },
    "group/conn": {
        "orientation": "inherit",
        "modules": ["bluetooth", "network"],
    },
    "group/out": {
        "orientation": "inherit",
        "modules": ["pulseaudio", "custom/battery"],
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true,
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90,
        },
        "tooltip": false,
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "states": {
            "warning": 70,
            "critical": 90,
        },
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB",
    },
    "custom/sep": {
        "format": "│",
        "tooltip": false,
    },
    "custom/cc": {
        "format": "",
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
    },
}
